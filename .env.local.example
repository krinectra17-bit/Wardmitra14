# ==============================================================================
# Ward 14 Portal (Smt. Pooja Manish Dadhich) - Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development, or add these variables
# directly into your Netlify / Hosting provider environment settings.

# 1. DATABASE (MongoDB Atlas)
# Connection string from MongoDB Atlas cluster (Connect -> Drivers -> Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Optional database name (defaults to 'ward14_db' if omitted)
MONGODB_DB=ward14_db

# 2. ADMIN AUTHENTICATION
# Primary administrator email used for login (defaults to admin@ward14.local)
ADMIN_EMAIL=admin@ward14.local

# Admin password or HMAC SHA-256 hash (Required)
# If using a plain password in development: e.g. ward14admin2026
ADMIN_PASSWORD=ward14admin2026
# Optional: pre-hashed password string for maximum security
ADMIN_PASSWORD_HASH=

# Cryptographic secret used to sign session cookies and tokens (Required)
# Use a random 32+ character string
AUTH_SECRET=your_super_secret_auth_token_key_change_me_in_production_2026

# 3. PHOTO UPLOADS (Cloudinary - Optional for citizen photo attachments)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. SITE URL
# Base public URL of the deployed portal
NEXT_PUBLIC_APP_URL=https://wardmitra14.netlify.app
